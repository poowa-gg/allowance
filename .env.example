# From developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is accepted on purpose (see src/config.ts)
PAYPAL_ENV=sandbox

# ---- Optional: a real language model for the demo agent (leave blank to use the free simulator) ----
# Option 1: Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Option 2: Groq (free tier, no card). Get a key at console.groq.com > API Keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b   (optional; the app finds a working model by itself if this one is missing)
# Option 3: any OpenAI-compatible service (set all three)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Cap on real-LLM agent runs per hour (protects your credits)
# ALLOWANCE_MAX_LLM_RUNS_PER_HOUR=20
